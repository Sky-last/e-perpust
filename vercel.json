{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/privacy-policy",
      "destination": "/privacy-policy.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/((?!privacy-policy\\.html$).*)",
      "destination": "/index.html"
    }
  ]
}
